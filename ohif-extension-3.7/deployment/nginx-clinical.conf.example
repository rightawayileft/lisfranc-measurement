# Include inside the site's existing HTTPS OHIF server block. Keep its existing
# network access restrictions. The credentials file contains named reviewers.
location ^~ /api/lisfranc-clinical/v1/ {
    satisfy all;
    auth_basic "Lisfranc Clinical reviewers";
    auth_basic_user_file /etc/nginx/private/lisfranc-reviewers.htpasswd;
    proxy_set_header X-Lisfranc-Actor $remote_user;
    include /etc/nginx/private/lisfranc-proxy-token.conf;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Origin $http_origin;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_cache off;
    client_max_body_size 16k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    access_log off;
    proxy_pass http://127.0.0.1:38612;
}

# The protected nginx include supplies this directive with the runtime secret:
# proxy_set_header X-Lisfranc-Proxy-Token "<server-owned token>";
